body{
    margin:0;
    font-family:Arial;
    display:flex;
    background:#f4f4f4;
}

.sidebar{
    width:250px;
    background:#1e293b;
    color:white;
    height:100vh;
    padding:20px;
}

.sidebar ul{
    list-style:none;
    padding:0;
}

.sidebar li{
    padding:10px 0;
}

.main{
    flex:1;
    padding:30px;
}

textarea{
    width:100%;
    height:150px;
    padding:10px;
}

button{
    background:#2563eb;
    color:white;
    border:none;
    padding:12px 20px;
    cursor:pointer;
}

.output{
    margin-top:20px;
    background:white;
    padding:20px;
    border-radius:8px;
}
h1{
    color:#1e293b;
}

textarea{
    border-radius:8px;
    border:1px solid #ccc;
}

button:hover{
    background:#1d4ed8;
}

.output{
    box-shadow:0 2px 5px rgba(0,0,0,0.1);
}

.sidebar h2{
    margin-bottom:30px;
}

.sidebar li{
    background:#334155;
    margin-bottom:10px;
    padding:12px;
    border-radius:6px;
}
.disclaimer{
    margin-top:20px;
    font-size:14px;
    color:#555;
}
